# ops/indexd.yml (generated from indexd.yml.tmpl by `make bootstrap`).
# DO NOT EDIT BY HAND — re-run `make bootstrap` to regenerate.
# Source template: ops/indexd.yml.tmpl

autoOpenWebUI: false
directory: /data
debug: false

# STORE-04: recovery phrase stays here (and in .env) permanently.
# Loss of this phrase = permanent data loss. See CONTEXT D-03 / STORE-04.
recoveryPhrase: {{ .RecoveryPhrase }}

adminAPI:
  address: :9980
  password: {{ .AdminPassword }}

applicationAPI:
  address: :9982
  # Phase 1: bootstrap wizard runs on the host, so advertiseURL must match what
  # it can reach (localhost:9982) — the SDK uses this URL for request signing
  # and indexd validates the signed Host header against advertiseURL.
  # Phase 2 planner flips this to "http://indexd:9982" when openweights-cas joins
  # the Compose network and the wizard no longer signs requests from the host.
  advertiseURL: "http://localhost:9982"

syncer:
  address: :9981
  bootstrap: true
  enableUPnP: false

consensus:
  # Phase 1 uses Zen testnet per CONTEXT D-10.
  # Phase 5/6 mainnet: planner changes this to "mainnet" with a mainnet-funded wallet.
  network: {{ .Network }}

database:
  host: postgres
  port: 5432
  user: indexd
  password: {{ .PostgresPassword }}
  database: indexd
  sslmode: disable

log:
  stdout:
    enabled: true
    level: info
    format: json
