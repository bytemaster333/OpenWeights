# ops/.env.prod.example — Production-overlay environment template.
#
# Copy to .env on the server, chmod 0600, fill in the values below:
#
#   cp ops/.env.prod.example .env
#   chmod 0600 .env
#   # then run `make setup` to generate the remaining secrets/keys, or fill them
#   # in by hand. DO NOT commit the filled-in .env.
#
# This AUGMENTS ops/.env.example (the dev template): start from that, carry its
# values over, and add / override the production-only ones below. Every variable
# the stack needs must be present in the single .env you create.
#
# CRITICAL: loss of OPENWEIGHTS_RECOVERY_PHRASE = permanent data loss on Sia.
# By design the phrase lives in this .env PERMANENTLY (inverted from Sia's
# end-user docs, which tell end-users to discard it).

# ============================================================================
# Domain — the ONE knob for a hosted deploy
# ============================================================================
# The console is served on <domain>, the CAS + gateway on cas.<domain>, on a
# single dual-SAN Let's Encrypt cert. Point BOTH DNS names at this server.
# The prod overlay (docker-compose.prod.yml) derives every public URL from this:
#   CONSOLE_BASE_URL, CAS_PUBLIC_URL, OPENWEIGHTS_CAS_PUBLIC_URL,
#   GATEWAY_BASE_URL, GITHUB_OAUTH_CALLBACK_URL, and the console's runtime URLs.
# You do NOT set those individually — change the domain here and they follow.
OPENWEIGHTS_DOMAIN=openweights.app

# ACME account email. Let's Encrypt mails expiry / revocation notices here.
# Use an address you actually monitor; a bounced notice means a missed renewal.
OPENWEIGHTS_ACME_EMAIL=you@example.com

# ============================================================================
# Sia
# ============================================================================
# BIP-39 recovery phrase for the wallet. `make setup` generates one if blank —
# write it down AND keep this .env; losing either orphans every stored xorb.
OPENWEIGHTS_RECOVERY_PHRASE=

# External Sia indexer the CAS + gateway talk to. Hosted https://sia.storage
# (50 GB free, no wallet funding) or your own indexd URL.
OPENWEIGHTS_INDEXER_URL=https://sia.storage

# ============================================================================
# GitHub OAuth — optional (password sign-in via OPENWEIGHTS_ADMIN_PASSWORD works
# without it). To enable "Continue with GitHub", register an OAuth App at
# https://github.com/settings/developers with callback URL EXACTLY:
#   https://cas.<OPENWEIGHTS_DOMAIN>/auth/github/callback
# (the overlay sets GITHUB_OAUTH_CALLBACK_URL from the domain; it must match the
# App registration byte-for-byte or GitHub rejects with redirect_uri_mismatch).
# ============================================================================
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ============================================================================
# Secrets / keys (base64 32 bytes each — `make setup` generates these)
# ============================================================================
# Signed-URL HMAC, shared by CAS (mints) + gateway (verifies). Rotation: move
# current to _PREV, mint a new one, redeploy; gateway accepts either in overlap.
GATEWAY_URL_SIGNING_KEY=
GATEWAY_URL_SIGNING_KEY_PREV=
GATEWAY_URL_TTL_SECS=7200

# HS256 key for OpenWeights-issued Xet JWTs. WITHOUT this the HF-compat token
# endpoints 500 and every hf upload/download fails.
XET_JWT_SIGNING_KEY=

# V2 reconstruction stays enabled in prod (xet-core falls back to V1 on 501).
V2_RECONSTRUCTION_ENABLED=true

# ============================================================================
# Smoke + preload helpers (ops/smoke.sh, ops/preload-fixture.sh)
# ============================================================================
# A read-scoped API key minted via the console after first-run onboarding.
OPENWEIGHTS_PUBLIC_READ_KEY=
# A write-scoped (or read+write) API key minted via the console.
OPENWEIGHTS_WRITE_KEY=
# Populated after the fixture preload; paste the hf upload receipt's file-id,
# re-source .env, rerun ops/smoke.sh. Until set, smoke.sh check #3 skips.
OPENWEIGHTS_FIXTURE_FILE_ID=
