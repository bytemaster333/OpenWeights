# ops/.env.prod.example — Production-overlay environment template.
#
# Plan 05-04. Copy to .env on the owner's server and fill in every value:
#
#   cp ops/.env.prod.example .env
#   chmod 0600 .env
#
# Then edit `.env` with the real secrets. DO NOT commit the filled-in .env.
#
# This file DOES NOT replace `ops/.env.example` (the dev template). It augments
# it with the production-only variables that Caddy + the mainnet Sia wallet +
# the production GitHub OAuth App require. The loaders merge both when
# docker-compose reads --env-file .env, so every variable below must be present
# in the single .env you create from this + the dev template.
#
# CRITICAL: loss of OPENWEIGHTS_RECOVERY_PHRASE = permanent data loss on Sia.
# By design, the phrase lives in this .env PERMANENTLY (this
# is INVERTED from Sia's end-user docs, which tell end-users to discard it).

# ============================================================================
# Start from ops/.env.example and carry all of its values over. The variables
# listed below are the PRODUCTION-SPECIFIC additions + overrides.
# ============================================================================

# ============================================================================
# Caddy + Let's Encrypt
# ============================================================================
# ACME account email. Let's Encrypt mails expiry / revocation notices here.
# Use an address you actually monitor; a bounced notice means a missed renewal.
OPENWEIGHTS_ACME_EMAIL=you@example.com

# ============================================================================
# Sia network + wallet
# ============================================================================
# `mainnet` for real Siacoin + real storage contracts; `zen` for testnet demo.
SIA_NETWORK=mainnet

# BIP-39 12-word recovery phrase for the mainnet wallet. If left blank the
# bootstrap wizard generates one at first boot — but write it down AND keep
# this .env — losing either orphans every xorb you have stored.
OPENWEIGHTS_RECOVERY_PHRASE=

# Mainnet threshold (~1 SC). Switch to 1e24 hastings (1 zSC) for Zen testnet.
OPENWEIGHTS_WALLET_THRESHOLD_HASTINGS=1000000000000000000000000

# indexd image — pin to the Phase-1-close digest, NOT :latest, in prod.
# Owner obtains the digest once with:
#   docker pull ghcr.io/siafoundation/indexd:latest
#   docker inspect --format='{{index .RepoDigests 0}}' ghcr.io/siafoundation/indexd:latest
# Then pastes the resulting `ghcr.io/...@sha256:...` here.
INDEXD_IMAGE=ghcr.io/siafoundation/indexd@sha256:REPLACE_ME_WITH_DIGEST

# ============================================================================
# GitHub OAuth — production app
# ============================================================================
# Register a new OAuth App at https://github.com/settings/developers
# with callback URL exactly: https://cas.openweights.app/auth/github/callback
# (The callback URL MUST match byte-for-byte or GitHub rejects with
# `redirect_uri_mismatch`.)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://cas.openweights.app/auth/github/callback
CONSOLE_BASE_URL=https://openweights.app

# ============================================================================
# Gateway signed-URL HMAC (32 random bytes, base64)
# ============================================================================
# Generate once: openssl rand 32 | base64
# Rotation: move current value to GATEWAY_URL_SIGNING_KEY_PREV, mint a new
# GATEWAY_URL_SIGNING_KEY, redeploy. Gateway accepts either during overlap.
GATEWAY_URL_SIGNING_KEY=
GATEWAY_URL_SIGNING_KEY_PREV=
GATEWAY_URL_TTL_SECS=7200

# Base URL stamped into minted signed URLs — matches ops/Caddyfile + compose
# prod overlay. If you change the cas.openweights.app/gateway path prefix, change
# this in lockstep AND update ops/Caddyfile's `handle_path /gateway/*` block.
GATEWAY_BASE_URL=https://cas.openweights.app/gateway

# V2 reconstruction is ENABLED in prod per D-65. Leave as-is unless debugging
# a regression; xet-core falls back to V1 on 501 if disabled.
V2_RECONSTRUCTION_ENABLED=true

# ============================================================================
# Smoke + preload helpers (ops/smoke.sh, ops/preload-fixture.sh)
# ============================================================================
# A read-scoped API key minted via the console after first-run onboarding.
# Required by ops/smoke.sh to exercise a fixture reconstruction end-to-end.
OPENWEIGHTS_PUBLIC_READ_KEY=

# A write-scoped API key minted via the console. Required by
# ops/preload-fixture.sh to upload the pinned fixture into the hosted demo.
OPENWEIGHTS_WRITE_KEY=

# Populated after the fixture preload finishes. The `hf upload` receipt
# prints the file-id on stdout; paste it here, re-source .env, then rerun
# ops/smoke.sh. Until populated, smoke.sh check #3 skips.
OPENWEIGHTS_FIXTURE_FILE_ID=
