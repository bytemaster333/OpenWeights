# SiaHub environment template (ops/-local mirror of /.env.example)
# Copy to .env and either fill in values OR leave empty (bootstrap auto-generates).
# CRITICAL: loss of SIAHUB_RECOVERY_PHRASE = permanent data loss (STORE-04).
# Per CONTEXT D-03, the recovery phrase stays in this file permanently (INVERTED from Sia's end-user docs).

# ========== Sia ==========
# Leave blank to auto-generate a fresh BIP-39 phrase at first `make bootstrap`.
SIAHUB_RECOVERY_PHRASE=
SIAHUB_APP_ID=                     # 32-byte hex constant; bootstrap reads from bench/appid
SIAHUB_APP_KEY=                    # bootstrap writes after derivation
SIAHUB_INDEXER_URL=http://indexd:9982
SIA_NETWORK=zen                    # Phase 1 uses Zen testnet per CONTEXT D-10

# ========== indexd internal ==========
INDEXD_ADMIN_PASSWORD=              # bootstrap generates if empty
INDEXD_POSTGRES_PASSWORD=           # bootstrap generates if empty
SIAHUB_WALLET_THRESHOLD_HASTINGS=1000000000000000000000000  # 1 zSC default (A4 in RESEARCH)

# ========== Postgres (SiaHub) ==========
POSTGRES_SUPERUSER_PASSWORD=        # bootstrap generates if empty
SIAHUB_POSTGRES_PASSWORD=           # bootstrap generates if empty
# Phase 3: siahub-gateway connects as the dedicated `siahub_gw` Postgres
# role created by cas/migrations/0005_siahub_gw_role.sql (SELECT on xorbs
# + INSERT on usage_log — nothing else). Password is propagated to the
# migration via `SET siahub.gw_password = ...` and to the gateway's
# DATABASE_URL at runtime. Must be non-empty before applying migration 0005.
SIAHUB_GW_POSTGRES_PASSWORD=        # bootstrap generates if empty

# ========== Redis ==========
REDIS_PASSWORD=                     # bootstrap generates if empty

# ========== indexd image digest ==========
# PIN AT PHASE 1 CLOSE via `docker pull ghcr.io/siafoundation/indexd:latest`
# + `docker inspect --format='{{index .RepoDigests 0}}' ghcr.io/siafoundation/indexd:latest`
INDEXD_IMAGE=ghcr.io/siafoundation/indexd:latest

# --- siahub-cas (Phase 2) -----------------------------------------------------
# HMAC-SHA256 key for signing gateway URLs. Base64 32 bytes. Shared between
# siahub-cas (mints) and siahub-gateway (verifies, Phase 3).
# Generate: openssl rand 32 | base64
GATEWAY_URL_SIGNING_KEY=

# Optional: previous key during rotation. Gateway accepts either; CAS mints only
# with current. Leave empty when not rotating.
GATEWAY_URL_SIGNING_KEY_PREV=

# TTL in seconds for minted gateway URLs. Default 7200 (2h) per Phase 2 D-14.
# Phase 3 may tighten if xet-core's refresh_url is confirmed (OQ-I).
GATEWAY_URL_TTL_SECS=7200

# Canonical URL base stamped into minted signed URLs (Plan 02-08). In local
# dev / docker-compose the Phase 3 gateway binds on loopback; in production
# the Caddy deployment serves https://cas.siahub.app.
GATEWAY_BASE_URL=http://127.0.0.1:9090

# V2 reconstruction feature flag.
# Phase 3 flip (Plan 03-07, RECEIVED §G): default is now `true` — the Go
# gateway serves RFC 7233 multipart/byteranges (Plan 03-04) and the CAS
# minter emits per-segment signed URLs (`r=s1-e1,s2-e2,...` via
# `mint_v1_multi_range`). Set to `false` ONLY when debugging a V2
# regression; the V1 reconstruction path remains fully functional and
# xet-core falls back to V1 on 501.
V2_RECONSTRUCTION_ENABLED=true

# Log level for the Rust CAS (tracing EnvFilter). Values: trace|debug|info|warn|error
RUST_LOG=info

# --- siahub-gateway (Phase 3) -------------------------------------------------
# Whole-xorb disk LRU root + capacity (bytes). Default 100 GiB. Canonical
# GATEWAY_CACHE_* names per 03-06; CACHE_* legacy aliases kept in compose.
GATEWAY_CACHE_DIR=/var/cache/siahub
GATEWAY_CACHE_SIZE_BYTES=107374182400
