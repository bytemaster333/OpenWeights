# OpenWeights environment template (ops/-local mirror of /.env.example)
# Copy to .env and either fill in values OR leave empty (bootstrap auto-generates).
# CRITICAL: loss of OPENWEIGHTS_RECOVERY_PHRASE = permanent data loss .
# Per CONTEXT , the recovery phrase stays in this file permanently (INVERTED from Sia's end-user docs).

# ========== Sia ==========
# Leave blank to auto-generate a fresh BIP-39 phrase at first `make bootstrap`.
OPENWEIGHTS_RECOVERY_PHRASE=
OPENWEIGHTS_APP_ID= # 32-byte hex constant; bootstrap reads from bench/appid
OPENWEIGHTS_APP_KEY= # bootstrap writes after derivation
# Indexer the whole stack (CAS + gateway) talks to. Default: the bundled
# self-hosted indexd (needs a funded wallet + enough usable hosts to form
# contracts). To use a hosted mainnet indexer with a deep host pool instead,
# set: OPENWEIGHTS_INDEXER_URL=https://sia.storage (register the app there with
# `openweights-cas-register`, which writes OPENWEIGHTS_APP_ID/APP_KEY here).
OPENWEIGHTS_INDEXER_URL=http://indexd:9982
SIA_NETWORK=zen # uses Zen testnet per
# ========== indexd internal ==========
INDEXD_ADMIN_PASSWORD= # bootstrap generates if empty
INDEXD_POSTGRES_PASSWORD= # bootstrap generates if empty
OPENWEIGHTS_WALLET_THRESHOLD_HASTINGS=1000000000000000000000000 # 1 zSC default (A4 in RESEARCH)

# ========== Postgres (OpenWeights) ==========
POSTGRES_SUPERUSER_PASSWORD= # bootstrap generates if empty
OPENWEIGHTS_POSTGRES_PASSWORD= # bootstrap generates if empty
# : openweights-gateway connects as the dedicated `openweights_gw` Postgres
# role created by cas/migrations/0005_openweights_gw_role.sql (SELECT on xorbs
# + INSERT on usage_log — nothing else). Password is propagated to the
# migration via `SET openweights.gw_password = ...` and to the gateway's
# DATABASE_URL at runtime. Must be non-empty before applying migration 0005.
OPENWEIGHTS_GW_POSTGRES_PASSWORD= # bootstrap generates if empty

# ========== Redis ==========
REDIS_PASSWORD= # bootstrap generates if empty

# ========== indexd image digest ==========
# PIN AT PHASE 1 CLOSE via `docker pull ghcr.io/siafoundation/indexd:latest`
# + `docker inspect --format='{{index .RepoDigests 0}}' ghcr.io/siafoundation/indexd:latest`
INDEXD_IMAGE=ghcr.io/siafoundation/indexd:latest

# --- openweights-cas -----------------------------------------------------
# HMAC-SHA256 key for signing gateway URLs. Base64 32 bytes. Shared between
# openweights-cas (mints) and openweights-gateway (verifies, ).
# Generate: openssl rand 32 | base64
GATEWAY_URL_SIGNING_KEY=

# Optional: previous key during rotation. Gateway accepts either; CAS mints only
# with current. Leave empty when not rotating.
GATEWAY_URL_SIGNING_KEY_PREV=

# TTL in seconds for minted gateway URLs. Default 7200 (2h) per .
# may tighten if xet-core's refresh_url is confirmed (OQ-I).
GATEWAY_URL_TTL_SECS=7200

# Canonical URL base stamped into minted signed URLs . In local
# dev / docker-compose the gateway binds on loopback; in production
# the Caddy deployment serves https://cas.openweights.app.
GATEWAY_BASE_URL=http://127.0.0.1:9090

# V2 reconstruction feature flag.
# flip (, RECEIVED §G): default is now `true` — the Go
# gateway serves RFC 7233 multipart/byteranges and the CAS
# minter emits per-segment signed URLs (`r=s1-e1,s2-e2,...` via
# `mint_v1_multi_range`). Set to `false` ONLY when debugging a V2
# regression; the V1 reconstruction path remains fully functional and
# xet-core falls back to V1 on 501.
V2_RECONSTRUCTION_ENABLED=true

# Download path. `true` (default): the CAS advertises the Xet reconstruction
# path so hf_xet fetches xorbs from the Go gateway (the proposal's
# gateway-serves-bytes design). `false`: the CAS reconstructs and serves the
# bytes itself (skips the gateway) — a working fallback.
OPENWEIGHTS_GATEWAY_READS=true

# Sia op budgets. A first mainnet pin is on-chain contract formation across many
# hosts and can take minutes: the upload handler accepts-pending after
# UPLOAD_BUDGET_SECS (fast, no client stall) and the background reconciler
# finishes the pin within OP_TIMEOUT_SECS. Lower both for a warmed local indexd.
OPENWEIGHTS_SIA_UPLOAD_BUDGET_SECS=20
OPENWEIGHTS_SIA_OP_TIMEOUT_SECS=3600

# Log level for the Rust CAS (tracing EnvFilter). Values: trace|debug|info|warn|error
RUST_LOG=info

# --- openweights-gateway -------------------------------------------------
# Whole-xorb disk LRU root + capacity (bytes). Default 100 GiB. Canonical
# GATEWAY_CACHE_* names per 03-06; CACHE_* legacy aliases kept in compose.
GATEWAY_CACHE_DIR=/var/cache/openweights
GATEWAY_CACHE_SIZE_BYTES=107374182400
