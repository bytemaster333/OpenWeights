# openweights-gateway — env template.
# Copy relevant values into the repo-root `.env` (single source of truth).
# See CONTEXT D-24..D-33 for rationale on each default.

# --- Mandatory ---------------------------------------------------------------
# HMAC-SHA256 key material; 32 raw bytes, base64 STANDARD-encoded (with padding).
# Share with openweights-cas — both services read the same value.
#   Generate: head -c32 /dev/urandom | base64
GATEWAY_URL_SIGNING_KEY=

# --- Optional ----------------------------------------------------------------
# Rotation window: when set, verifier accepts signatures from EITHER key.
# CAS mints with CURRENT only; operators rotate by copying CURRENT -> PREV,
# generating a new CURRENT, and rolling restart both services.
GATEWAY_URL_SIGNING_KEY_PREV=

# URL TTL (seconds). Default 7200 (2h) per D-25.
GATEWAY_URL_TTL_SECS=7200

# Informational — matches the value CAS mints URLs against. Gateway does not
# validate URL prefix (HMAC runs over canonical string only), but having this
# field keeps the env surface symmetric with CAS.
GATEWAY_BASE_URL=http://127.0.0.1:9090

# Listener addrs. Public MUST be 0.0.0.0 for Compose; metrics MUST be loopback (D-33).
GATEWAY_ADDR=:8081
GATEWAY_METRICS_ADDR=127.0.0.1:9100

# --- Consumed by plan 03-02 --------------------------------------------------
# RO for xorbs, RW for usage_log. Connection string created by migration
# `cas/migrations/NNN_create_openweights_gw_user.sql` in plan 03-02.
POSTGRES_URL=postgres://openweights_gw:PASSWORD@postgres:5432/openweights?application_name=openweights-gateway

# Sia app API endpoint (same service openweights-cas talks to).
SIA_INDEXER_URL=http://indexd:9982

# App Key (stays in .env only — PITFALL P6; never persisted in Postgres).
APP_KEY=

# --- Consumed by plan 03-05 / 03-06 ------------------------------------------
# Whole-xorb disk LRU root + capacity (bytes). Default 100 GiB.
# Canonical env vars (GATEWAY_*); CACHE_DIR / CACHE_SIZE_BYTES kept as legacy
# aliases. The canonical name wins when both are set.
GATEWAY_CACHE_DIR=/var/cache/openweights
GATEWAY_CACHE_SIZE_BYTES=107374182400

# Legacy aliases — still honored for back-compat.
# CACHE_DIR=/var/cache/openweights
# CACHE_SIZE_BYTES=107374182400

# --- /metrics listener (OPS-03 / D-33) ----------------------------------------
# `/metrics` binds to loopback ONLY; Caddy MUST NOT proxy it. Scrape from the
# host via `docker compose exec openweights-gateway wget -qO- http://127.0.0.1:9100/metrics`.
# Changing this to 0.0.0.0 exposes the registry publicly — DO NOT.
# (Listener-level binding; the default is safe.)
# GATEWAY_METRICS_ADDR=127.0.0.1:9100
