# Browser-visible origins (non-secret; inlined into bundle at build time).
# Per D-55, no secret may be shipped to the browser via VITE_*.
VITE_CAS_URL=http://localhost:8080
VITE_GATEWAY_URL=http://localhost:9090

# Optional: override conformance-badge JSON URL (default = /conformance-badge.json).
VITE_CONFORMANCE_BADGE_URL=
