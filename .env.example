# OpenWeights environment template
# Copy to .env and either fill in values OR leave empty (bootstrap auto-generates).
# CRITICAL: loss of OPENWEIGHTS_RECOVERY_PHRASE = permanent data loss .
# Per CONTEXT , the recovery phrase stays in this file permanently (INVERTED from Sia's end-user docs).

# ========== Sia ==========
# Leave blank to auto-generate a fresh BIP-39 phrase at first `make bootstrap`.
OPENWEIGHTS_RECOVERY_PHRASE=
OPENWEIGHTS_APP_ID= # 32-byte hex constant; bootstrap reads from bench/appid
OPENWEIGHTS_APP_KEY= # bootstrap writes after derivation
OPENWEIGHTS_INDEXER_URL=http://indexd:9982
SIA_NETWORK=zen # uses Zen testnet per 
# ========== indexd internal ==========
INDEXD_ADMIN_PASSWORD= # bootstrap generates if empty
INDEXD_POSTGRES_PASSWORD= # bootstrap generates if empty
OPENWEIGHTS_WALLET_THRESHOLD_HASTINGS=1000000000000000000000000 # 1 zSC default (A4 in RESEARCH)

# ========== Postgres (OpenWeights) ==========
POSTGRES_SUPERUSER_PASSWORD= # bootstrap generates if empty
OPENWEIGHTS_POSTGRES_PASSWORD= # bootstrap generates if empty

# ========== Redis ==========
REDIS_PASSWORD= # bootstrap generates if empty

# ========== indexd image digest ==========
# PIN AT PHASE 1 CLOSE via `docker pull ghcr.io/siafoundation/indexd:latest`
# + `docker inspect --format='{{index .RepoDigests 0}}' ghcr.io/siafoundation/indexd:latest`
INDEXD_IMAGE=ghcr.io/siafoundation/indexd:latest

# ========== GitHub OAuth ( / ) ==========
# Register a GitHub OAuth App and paste the client id + secret here.
# (HIGH — self-host friction): GITHUB_OAUTH_CALLBACK_URL MUST match the
# "Authorization callback URL" configured in the OAuth App settings exactly.
# Mismatch surfaces from GitHub as an opaque `redirect_uri_mismatch` error
# and is the single most common self-hosting snag.
# Local dev: http://localhost:8080/auth/github/callback
# Production: https://cas.openweights.app/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/auth/github/callback
# Where CAS redirects the browser after a successful callback (console origin).
CONSOLE_BASE_URL=http://localhost:5173
